   "source": [
    "# Running the query function in parallel\n",
    "\n",
    "# Each listing appears in up to nine monthly files, but its coordinates are the same,\n",
    "# so we only query each unique lat/long pair once (far fewer API calls)\n",
    "unique_coords = list(airbnb_data[[\"latitude\", \"longitude\"]].drop_duplicates().itertuples(index = False, name = None))\n",
    "\n",
    "# Running through the unique pairs in parallel\n",
    "with ThreadPoolExecutor(max_workers = num_workers) as executor:\n",
    "    unique_results = list(\n",
    "# Setting up a list with just the lat and long for parllelisation\n",
    "unique_coords = airbnb_data[[\"latitude\", \"longitude\"]].drop_duplicates()\n",
    "coords = list(zip(unique_coords[\"latitude\"], unique_coords[\"longitude\"]))\n",
    "# Running through the list in parallel and for each lat/long, add to the results object\n",
    "with ThreadPoolExecutor(max_workers = NUM_WORKERS) as executor:\n",
    "    results = list(\n",
    "        executor.map(\n",
    "            lambda xy: koord_query(xy[0], xy[1]),\n",
    "            unique_coords\n",
    "        )\n",
    "    )\n",
    "\n",
    "# Mapping the results back onto every row; failed lookups become <NA> (nullable integer)\n",
    "lookup_sa = dict(zip(unique_coords, unique_results))\n",
    "results = [lookup_sa[xy] for xy in zip(airbnb_data[\"latitude\"], airbnb_data[\"longitude\"])]\n",
    "airbnb_data[\"SA22019_V1_00\"] = pd.array(results, dtype = \"Int64\")"
    "# Adding the results to the df again\n",
    "unique_coords[\"SA22019_V1_00\"] = results\n",
    "airbnb_data = airbnb_data.merge(unique_coords, on = [\"latitude\", \"longitude\"], how = \"left\")"
   ]
  },
